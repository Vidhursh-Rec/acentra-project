# Copy to backend/.env and fill in. Never commit .env.

# Supabase — Project Settings → API / Database
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_STORAGE_BUCKET=discharge-docs

# Groq
GROQ_API_KEY=
GROQ_EXTRACT_MODEL=openai/gpt-oss-120b
GROQ_TRANSLATE_MODEL=openai/gpt-oss-20b

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# Expo push (optional; only needed if push security is enabled on your Expo project)
EXPO_ACCESS_TOKEN=

# Rules
TIMEZONE=Asia/Kolkata
APPROVAL_WINDOW_HOURS=12
MISSED_DOSE_WINDOW_HOURS=4
SLOT_MORNING=06:00-11:00
SLOT_AFTERNOON=12:00-16:00
SLOT_NIGHT=18:00-22:00
EMERGENCY_NUMBER=108
