{
  "expo": {
    "name": "CareBridge",
    "slug": "carebridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app/app-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/app/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/app/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CareBridge uses your location to show nearby doctors, hospitals and labs."
        }
      ]
    ],
    "scheme": "carebridge"
  }
}
