# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL (async):  postgresql+asyncpg://user:pass@host/dbname?sslmode=require
# SQLite fallback (no cloud needed):  sqlite+aiosqlite:///./fraud.db
DATABASE_URL=sqlite+aiosqlite:///./fraud.db

# ── AWS SNS / SES (optional — mock logger used when blank) ───────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:FraudHighRiskAlerts

# ── App config ────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
HIGH_RISK_THRESHOLD=70
